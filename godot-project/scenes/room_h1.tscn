[node name="Townsfolk1" parent="." instance=ExtResource("6")]
position = Vector2(-600, 150)
npc_name = "TOWNSFOLK"
tint = Color(0.6, 0.55, 0.5, 1)
lines = PackedStringArray("Heard about the Kanryu bounty? Fifty thousand. I'd sell my own shadow for half.", "Wrath took six contracts last week. Six. The man's a machine.")
repeat_lines = PackedStringArray("You after the Kanryu mark too? ...Didn't think so.")
talk_flag = "h1_townsfolk1_met"

[node name="Townsfolk2" parent="." instance=ExtResource("6")]
position = Vector2(100, -100)
npc_name = "TOWNSFOLK"
tint = Color(0.5, 0.6, 0.55, 1)
lines = PackedStringArray("Murray's bar, east side. Best ale in the Reprieve. Don't ask about the shelf blend.", "The alleys north of here? Creatures, mostly harmless. Mostly.")
repeat_lines = PackedStringArray("Back alleys are north. Mind the siltmaw dirt.")
talk_flag = "h1_townsfolk2_met"

[node name="Townsfolk3" parent="." instance=ExtResource("6")]
position = Vector2(900, 200)
npc_name = "TOWNSFOLK"
tint = Color(0.55, 0.5, 0.6, 1)
lines = PackedStringArray("Dockside shops are south. Fenna's the fletcher — best customer she ever had just... stopped coming.", "They say the bar's messenger fairy only comes for big bounties.")
repeat_lines = PackedStringArray("Shops are south, bar's east. You'll find your way.")
talk_flag = "h1_townsfolk3_met"

[node name="Wrath" parent="." instance=ExtResource("6")]
position = Vector2(400, 100)
npc_name = "WRATH"
art_id = "wrath"
lines = PackedStringArray("So. The new reaper finally shows his face.", "I've read your bounty sheet. Try not to die before I get to you.")
repeat_lines = PackedStringArray("We finish this when you're ready. Not before.")
talk_flag = "h1_wrath_met"

